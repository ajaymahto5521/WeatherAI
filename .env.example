# =============================================================================
# Weather Intelligence Assistant — Environment Variables Template
# =============================================================================
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to Git
#
# All variables are read by app/config.py using pydantic-settings.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
APP_DEBUG=true               # true = verbose logging, false = production logging
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_HOST=0.0.0.0             # host to bind the server to
APP_PORT=8000                # port to run the server on


# -----------------------------------------------------------------------------
# LLM — Azure OpenAI (or standard OpenAI)
# Get these from: https://portal.azure.com -> Azure OpenAI resource
# -----------------------------------------------------------------------------
OPENAI_API_TYPE=azure                              # azure | openai
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o               # your deployment name
AZURE_OPENAI_API_VERSION=2024-02-01

# If using standard OpenAI instead of Azure, set these:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL_NAME=gpt-4o


# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL + pgvector
# Used by the RAG pipeline (Milestone 2+)
# For local dev: docker compose up starts a postgres container automatically
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weather_intelligence
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=your-strong-password-here


# -----------------------------------------------------------------------------
# LIVE WEATHER TOOL (Milestone 4+)
# Free API key from: https://openweathermap.org/api
# Sign up -> My API Keys -> copy the key
# -----------------------------------------------------------------------------
OPENWEATHER_API_KEY=your-openweathermap-api-key-here


# -----------------------------------------------------------------------------
# EMBEDDING MODEL
# We use a local sentence-transformers model (no API key needed).
# Override here if you want a different model.
# Default: "all-MiniLM-L6-v2" (fast, small, good quality)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2


# -----------------------------------------------------------------------------
# RAG SETTINGS
# -----------------------------------------------------------------------------
RAG_CHUNK_SIZE=500           # characters per chunk
RAG_CHUNK_OVERLAP=50         # overlap between consecutive chunks
RAG_TOP_K=4                  # how many chunks to retrieve per query


# -----------------------------------------------------------------------------
# TRAINED MODEL PATHS (Milestone 1+)
# Relative to project root
# -----------------------------------------------------------------------------
FORECASTING_MODEL_PATH=models/forecaster.joblib
SEVERITY_MODEL_PATH=models/severity_classifier
